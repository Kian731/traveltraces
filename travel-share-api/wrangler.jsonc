{
	"name": "travel-share-api",
	"main": "src/index.js",
	"compatibility_date": "2026-09-11",
	"observability": {
		"enabled": true,
	},
	"vars": {
		"ALLOWED_ORIGINS": "https://kian731.github.io,http://127.0.0.1:4173,http://localhost:4173"
	},
	"ratelimits": [
		{
			"name": "SHARE_RATE_LIMITER",
			"namespace_id": "1001",
			"simple": { "limit": 5, "period": 60 }
		}
	],
	"triggers": {
		"crons": ["17 3 * * *"]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "travel-share-db",
			"database_id": "edac9224-460b-488e-ae26-f852f4341eb6"
		}
	],
}
